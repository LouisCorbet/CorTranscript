# Réglages communs (utilisés par le build ET par l'exécution : après modification, relance « docker compose up --build »)
WHISPER_MODEL=small
WHISPER_LANGUAGE=fr

# Modèle de streaming réel (archive sherpa-onnx téléchargée au build).
# Par défaut : Kroko FR, précis, léger (57 Mo) et ponctué, mais sous licence NON COMMERCIALE.
# Alternative sous licence Apache-2.0 : sherpa-onnx-streaming-zipformer-fr-2023-04-14
# (texte en majuscules sans ponctuation, moins fiable, archive de ~400 Mo, environ 2,5 fois plus lent)
SHERPA_MODEL=sherpa-onnx-streaming-zipformer-fr-kroko-2025-08-06
